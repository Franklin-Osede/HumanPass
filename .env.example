# HumanPass secrets. Do not edit by hand: run `scripts/init-env.sh` to create `.env`
# with random values. Values are embedded in connection URLs, so they MUST be hex only.

# Postgres superuser. Used only by the postgres init script and the one-shot migrate services.
POSTGRES_PASSWORD=

# Runtime LOGIN roles (created by db/init/00-roles.sh).
IDENTITY_API_DB_PASSWORD=
BIOMETRIC_ENGINE_DB_PASSWORD=

# Shared secret sent by identity-api as X-Service-Token to biometric-engine.
BIOMETRIC_ENGINE_SERVICE_TOKEN=
